
<%- include('../partials/head') %>
<link rel="stylesheet" href="/styles/home-form.css">
</head>

<body>
  <%- include('../partials/nav') %>

  <main class="home-form-page">
    <div class="home-form-card">

      <div class="form-header">
        <h1>
          <%= editing ? "Edit Your Home" : "Register Your Home" %>
        </h1>
        <p>
          <%= editing
            ? "Update your property details below."
            : "Share your space with guests and make them feel at home." %>
        </p>
      </div>

      <form
        class="home-form"
        action="<%= editing ? '/edit-home' : '/add-home' %>"
        method="post"
        enctype="multipart/form-data"
      >
        <input
          type="hidden"
          name="id"
          value="<%= editing ? home._id : '' %>"
        >

        <div class="form-group">
          <label class="label-name" for="houseName">House Name</label>
          <input
            class="input-detail"
            value="<%= editing ? home.houseName : '' %>"
            id="houseName"
            type="text"
            name="houseName"
            placeholder="Enter your house name"
            required
          >
        </div>

        <div class="form-group">
          <label class="label-name" for="price">Price per Night (₹)</label>
          <input
            class="input-detail"
            value="<%= editing ? home.price : '' %>"
            id="price"
            type="number"
            name="price"
            min="0"
            placeholder="Enter price per night"
            required
          >
        </div>

        <div class="form-group">
          <label class="label-name" for="location">Location</label>
          <input
            class="input-detail"
            value="<%= editing ? home.location : '' %>"
            id="location"
            type="text"
            name="location"
            placeholder="Enter property location"
            required
          >
        </div>

        <div class="form-group">
          <label class="label-name" for="rating">Rating</label>
          <input
            class="input-detail"
            value="<%= editing ? home.rating : '' %>"
            id="rating"
            type="number"
            name="rating"
            min="0"
            max="5"
            step="0.1"
            placeholder="Rating out of 5"
          >
        </div>

        <div class="form-group">
          <label class="label-name" for="photo">
            Property Photos
            <span class="optional-text">
              <%= editing ? "(Optional: choose to replace)" : "" %>
            </span>
          </label>
          <input
            class="input-detail file-input"
            id="photo"
            type="file"
            name="photo"
            accept="image/jpeg,image/png,image/jpg"
            multiple
            <%= editing ? '' : 'required' %>
          >
          <small class="field-help">
            Accepted formats: JPG, JPEG and PNG.
          </small>
        </div>

        <div class="form-group">
          <label class="label-name" for="description">Description</label>
          <textarea
            class="input-detail description-input"
            id="description"
            name="description"
            placeholder="Describe your home and its best features"
            rows="4"
          ><%= editing ? (home.description || '') : '' %></textarea>
        </div>

        <button class="submit-btn" type="submit">
          <%= editing ? "Update Home" : "Register Home" %>
        </button>

      </form>
    </div>
  </main>
</body>
</html>
